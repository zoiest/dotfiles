#!/usr/bin/env bash
#
# Bootstrap this dotfiles checkout on a new machine (Linux or macOS).
#
# Usage:
#   ./INSTALL          Install, using the default git identity
#   ./INSTALL -m       Install, prompting for git name / email / editor /
#                      LFS / GPG. The flag is forwarded verbatim to
#                      git/configure-gitconfig.sh, which is the only thing
#                      that reads it.
#
# Steps, in order:
#   1. System packages via apt (Linux) or brew (macOS)
#   2. Nerd Fonts into ~/.fonts (Linux only)
#   3. Git submodules, then fzf from submodules/fzf
#   4. ydiff and diff-so-fancy into ~/.local/bin
#   5. epdfinfo, the server binary Emacs pdf-tools needs
#   6. Symlink every config tree into $HOME with GNU stow
#   7. Generate ~/.gitconfig
#
# Re-running is supported but NOT purely additive: step 3 deletes and
# recreates ~/.fzf, and step 5 removes ~/.vim, ~/.config/kitty,
# ~/.config/lazygit and ~/.tmux.conf before stow re-links them. Any local
# edits in those paths that are not tracked in this repo will be lost.
#
# Requires sudo on Linux (apt) and an existing Homebrew install on macOS.

set -euxo pipefail

mkdir -p ~/.local/bin

export PLATFORM=$(uname -s)

if [ "$PLATFORM" = Linux ]; then
   sudo apt-get update
   # libpoppler-*, libpng, zlib, autoconf, automake and pkg-config are the
   # build dependencies for Emacs pdf-tools' epdfinfo server;
   # elpa-pdf-tools-server supplies a prebuilt /usr/bin/epdfinfo so no
   # compilation is normally needed on Debian/Ubuntu.
   sudo apt-get install -y tig ripgrep pandoc \
       libpoppler-glib-dev libpoppler-private-dev libpng-dev zlib1g-dev \
       autoconf automake pkg-config elpa-pdf-tools-server
   # sudo apt-get install -y stow golang python3-pip python3.10-venv ranger
   # curl -fsSL https://deb.nodesource.com/setup_21.x | sudo -E bash - &&\
   #     sudo apt-get install -y nodejs

   mkdir --parent ~/.fonts
   for font in JetBrainsMono.tar.xz Go-Mono.tar.xz Iosevka.tar.xz ; do
       if [ ! -f ~/.fonts/"${font}" ]; then
           curl -L -o ~/.fonts/"${font}" \
               https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/"${font}"
           tar xvf ~/.fonts/"${font}" -C ~/.fonts/
           sudo fc-cache -fv
       fi
   done
elif [ "$PLATFORM" = Darwin ]; then
    brew install stow
    # brew install golang node python3
    # pip3 install virtualenv
    # poppler, pkg-config, automake and autoconf are the build dependencies
    # for epdfinfo, which has no Homebrew formula and must be compiled below.
    # pdf-tools' own build script locates them through `brew --prefix', so
    # Homebrew has to be on Emacs' exec-path too -- see my-add-homebrew-paths
    # in emacs/.emacs.d/config.org.
    brew install font-hack-nerd-font tig ripgrep pandoc \
        poppler pkg-config automake autoconf
fi

echo "Fetch all git submodules..."
git submodule update --recursive --init

# Clean up old conf if there is any
rm -rf ~/.fzf
cp -r submodules/fzf ~/.fzf
~/.fzf/install --all

rm -rf ~/.vim ~/.config/kitty ~/.config/lazygit
rm -f ~/.tmux.conf

# Install diff tools
# install ydiff
curl -L https://raw.github.com/ymattw/ydiff/master/ydiff.py > ~/.local/bin/ydiff
chmod +x ~/.local/bin/ydiff
# install diff-so-fancy
curl -L https://github.com/so-fancy/diff-so-fancy/releases/latest/download/diff-so-fancy > ~/.local/bin/diff-so-fancy
chmod +x ~/.local/bin/diff-so-fancy

# ---------------------------------------------------------------------------
# epdfinfo: the server binary behind Emacs pdf-tools
# ---------------------------------------------------------------------------
# pdf-tools renders pages through a separate C program, epdfinfo, which is
# NOT shipped with the Emacs package. Without it, opening any PDF fails with:
#
#   File mode specification error: (error pdf-info-epdfinfo-program is not executable)
#
# Emacs locates it with (executable-find "epdfinfo"), so it only has to be
# somewhere on PATH. ~/.local/bin is used here because the Emacs config
# already adds that directory to exec-path.
#
#   Linux - elpa-pdf-tools-server (installed above) provides
#           /usr/bin/epdfinfo. The fallback below covers releases where that
#           package is unavailable, by unpacking the .deb by hand.
#   macOS - nothing provides a prebuilt binary, so compile it with
#           pdf-tools' own server/autobuild script. The brew step above
#           already installed poppler/pkg-config/automake/autoconf, so -D
#           tells autobuild to skip its own dependency installation.
#
# Either way this is skipped entirely when epdfinfo is already on PATH.
if ! command -v epdfinfo >/dev/null 2>&1; then
    TEMP_DIR=$(mktemp -d)
    if [ "$PLATFORM" = Linux ]; then
        (cd "$TEMP_DIR" && apt-get download elpa-pdf-tools-server 2>/dev/null && dpkg-deb -x elpa-pdf-tools-server*.deb . && cp usr/bin/epdfinfo ~/.local/bin/epdfinfo && chmod +x ~/.local/bin/epdfinfo) || true
    elif [ "$PLATFORM" = Darwin ]; then
        (git clone --depth 1 https://github.com/vedang/pdf-tools "$TEMP_DIR/pdf-tools" \
            && cd "$TEMP_DIR/pdf-tools/server" \
            && ./autobuild -i "$HOME/.local/bin" -D) \
            || echo "WARNING: epdfinfo build failed. Start Emacs and run 'M-x pdf-tools-install'."
    fi
    rm -rf "$TEMP_DIR"
fi

stow --target=$HOME vim nvim tmux ranger wezterm vscode kitty lazygit ghostty emacs herdr
git/configure-gitconfig.sh ${1:-}
